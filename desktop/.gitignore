# Staged by scripts/prepare-sidecar.mjs (regenerated from dist-bin/ on every build)
src-tauri/binaries/ashlr-*
src-tauri/resources/

# Nightly dev-build artifact output (scripts/build-desktop-nightly.mjs --out)
dist-nightly/

# Raster icons regenerated by `tauri icon src-tauri/icons/icon.svg` on every
# build; tray.png is the only checked-in raster.
src-tauri/icons/*.png
!src-tauri/icons/tray.png
