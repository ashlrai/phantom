<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ashlr.staged-drain</string>
  <key>ProgramArguments</key>
  <array>
    <string>__STAGED_DRAIN_SH__</string>
  </array>
  <key>StartInterval</key>
  <integer>__INTERVAL__</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/staged-drain.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/staged-drain.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>STAGED_DRAIN_WORK</key>
    <string>__WORK__</string>
    <key>STAGED_DRAIN_PUBLISH</key>
    <string>__PUBLISH__</string>
  </dict>
</dict>
</plist>
