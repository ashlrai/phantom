<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ashlr.usage-hourly</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__USAGE_SIGNAL_JS__</string>
    <string>--directory</string><string>__OPS_DIRECTORY__</string>
    <string>--event</string><string>hourly</string>
    <string>--readers</string><string>__READERS_JSON__</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>__PATH__</string>
  </dict>
</dict>
</plist>
