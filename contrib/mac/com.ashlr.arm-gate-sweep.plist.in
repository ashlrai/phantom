<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.ashlr.arm-gate-sweep</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON3__</string><string>-I</string><string>-B</string><string>__RUNS__/bin/arm_gate.py</string>
    <string>sweep</string><string>--dir</string><string>__RUNS__/arm-deferred</string><string>--apply</string>
  </array>
  <key>StartInterval</key><integer>__INTERVAL__</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__RUNS__/logs/arm-gate-sweep.out.log</string>
  <key>StandardErrorPath</key><string>__RUNS__/logs/arm-gate-sweep.err.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>__PATH__</string>
  </dict>
</dict></plist>
