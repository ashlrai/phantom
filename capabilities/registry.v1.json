  "capabilities": [
    {
      "id": "phantom-gateway", "kind": "mcp", "description": "Phantom MCP gateway (phm mcp).",
      "surfaces": ["claude-code", "claude-desktop", "codex-cli", "codex-desktop", "devin-cli", "devin-desktop", "cursor-desktop", "cursor-agent", "grok-build", "gemini-cli", "copilot-cli"],
      "effects": ["read", "write-local"], "sensitivity": { "external_send": false, "spend": false, "delete": false },
      "launch": { "command": "phm", "args": ["mcp"] }
    },
    {
      "id": "phantom-secrets", "kind": "mcp", "description": "Phantom Secrets companion: vault names and leases, never values in agent context.",
      "surfaces": ["claude-code", "codex-cli", "devin-cli", "devin-desktop", "cursor-desktop"],
      "effects": ["read"], "sensitivity": { "external_send": false, "spend": false, "delete": false }, "hardLimitGates": ["secrets"],
      "launch": { "command": "npx", "args": ["-y", "phantom-secrets-mcp@0.7.9"] }
    },
    {
      "id": "locus", "kind": "mcp", "description": "Locus companion: repository and fleet location index.",
      "surfaces": ["claude-code", "claude-desktop", "codex-cli", "codex-desktop", "devin-cli", "devin-desktop", "cursor-desktop", "cursor-agent", "gemini-cli", "copilot-cli"],
      "effects": ["read"], "sensitivity": { "external_send": false, "spend": false, "delete": false },
      "launch": { "command": "npx", "args": ["-y", "@ashlrai/locus-mcp@0.7.0"] }
    },
    {
      "id": "lexicon", "kind": "mcp", "description": "Lexicon companion: voice vocabulary corrections.",
      "surfaces": ["claude-code", "claude-desktop", "codex-cli", "codex-desktop", "devin-cli", "devin-desktop", "cursor-desktop"],
      "effects": ["read"], "sensitivity": { "external_send": false, "spend": false, "delete": false },
      "launch": { "command": "npx", "args": ["-y", "-p", "@ashlr/lexicon@0.5.9", "lexicon-mcp"] }
    },
    {
      "id": "stack", "kind": "mcp", "description": "ashlr-stack companion: provider and stack inventory.",
      "surfaces": ["claude-code", "codex-cli", "devin-cli", "devin-desktop"],
      "effects": ["read"], "sensitivity": { "external_send": false, "spend": false, "delete": false },
      "launch": { "command": "npx", "args": ["-y", "-p", "@ashlr/stack@0.3.6", "-p", "ashlr-stack-mcp@0.3.6", "-p", "phantom-secrets@0.7.9", "ashlr-stack-mcp"] }
    },
    {
      "id": "ashlr", "kind": "mcp", "description": "ashlr-plugin MCP: token-efficient read, grep and edit tools.",
      "surfaces": ["claude-code", "codex-cli", "devin-cli", "devin-desktop"],
      "effects": ["read", "write-local"], "sensitivity": { "external_send": false, "spend": false, "delete": false },
      "launch": { "command": "npx", "args": ["-y", "-p", "ashlr-plugin@1.36.4", "ashlr-mcp"] }
    },
    {
      "id": "slack-post", "kind": "connector", "description": "Post a Slack message as the fleet bot.",
      "surfaces": ["claude-code", "codex-cli"], "accounts": ["slack-bot"],
      "effects": ["post-slack"], "sensitivity": { "external_send": true, "spend": false, "delete": false }, "hardLimitGates": ["outside-send"]
    },
    {
      "id": "mail-send", "kind": "connector", "description": "Send mail through Apple Mail.",
      "surfaces": ["claude-desktop", "claude-code"], "accounts": ["apple-mail"],
      "effects": ["send-mail"], "sensitivity": { "external_send": true, "spend": false, "delete": false }, "hardLimitGates": ["outside-send"],
      "control": { "backend": "applescript" }
    },
    {
      "id": "messages-send", "kind": "connector", "description": "Send an iMessage through Messages.",
      "surfaces": ["claude-desktop", "claude-code"], "accounts": ["apple-messages"],
      "effects": ["send-message"], "sensitivity": { "external_send": true, "spend": false, "delete": false }, "hardLimitGates": ["outside-send"],
      "control": { "backend": "jxa" }
    },
    {
      "id": "devin-acu-topup", "kind": "connector", "description": "Buy Devin ACUs.",
      "surfaces": ["devin-desktop"], "accounts": ["devin-billing"],
      "effects": ["spend"], "sensitivity": { "external_send": false, "spend": true, "delete": false }, "hardLimitGates": ["money"]
    },
    {
      "id": "gh", "kind": "cli", "description": "GitHub CLI for PRs, issues and checks.",
      "surfaces": ["claude-code", "codex-cli", "devin-cli", "cursor-agent", "grok-build", "gemini-cli", "copilot-cli"], "accounts": ["github"],
      "effects": ["read", "write-remote"], "sensitivity": { "external_send": false, "spend": false, "delete": false },
      "launch": { "command": "gh", "args": [] }
    },
    {
      "id": "gh-repo-delete", "kind": "cli", "description": "Delete a GitHub repository.",
      "surfaces": ["claude-code"], "accounts": ["github"],
      "effects": ["delete-data"], "sensitivity": { "external_send": false, "spend": false, "delete": true }, "hardLimitGates": ["destroy-data"],
      "launch": { "command": "gh", "args": ["repo", "delete"] }
    },
    {
      "id": "browser-verify", "kind": "skill", "description": "Verify a local web UI in a loopback browser with a per-run profile.",
      "surfaces": ["claude-code", "codex-cli"],
      "effects": ["read"], "sensitivity": { "external_send": false, "spend": false, "delete": false },
      "control": { "backend": "playwright-loopback", "profile": "per-run", "bind": "127.0.0.1" },
      "autoFile": { "fields": ["capability-id", "surface-id", "job-id", "outcome", "duration-ms", "error-code"] }
    },
    {
      "id": "shortcuts-run", "kind": "connector", "description": "Run a named, owner-approved macOS Shortcut.",
      "surfaces": ["claude-desktop"],
      "effects": ["write-local"], "sensitivity": { "external_send": false, "spend": false, "delete": false },
      "control": { "backend": "shortcuts" }
    },
    {
      "id": "ashlr-plugin", "kind": "plugin", "description": "ashlr Claude Code plugin (skills, hooks, MCP).",
      "surfaces": ["claude-code"],
      "effects": ["read", "write-local"], "sensitivity": { "external_send": false, "spend": false, "delete": false }
    }
  ]
}
