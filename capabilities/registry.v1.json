  ],
  "accounts": [
    { "id": "github", "provider": "github", "store": "host-session", "credentialName": null, "scopes": ["repo", "workflow"] },
    { "id": "slack-bot", "provider": "slack", "store": "phantom-secrets", "credentialName": "SLACK_BOT_TOKEN", "scopes": ["chat:write"] },
