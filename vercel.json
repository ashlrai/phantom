{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "buildCommand": "echo 'Static Verse site: source files are ready'",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- site vercel.json || exit 1",
  "installCommand": "",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://phm.dev/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "https://phm.dev/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "https://phm.dev/",
      "permanent": true
    },
    {
      "source": "/ecosystem",
      "destination": "https://phm.dev/ecosystem",
      "permanent": true
    },
    {
      "source": "/ecosystem.html",
      "destination": "https://phm.dev/ecosystem",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://phm.dev/sitemap.xml",
      "permanent": true
    }
  ]
}
