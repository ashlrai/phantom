{
  "type": "object",
  "required": [
    "schema_version",
    "initialized",
    "inspection",
    "managed_dotenv",
    "vault",
    "proxy",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "initialized": {
      "type": "boolean"
    },
    "inspection": {
      "const": "metadata-only"
    },
    "managed_dotenv": {
      "type": "object",
      "required": [
        "inspected"
      ],
      "properties": {
        "inspected": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "vault": {
      "type": "object",
      "required": [
        "inspected"
      ],
      "properties": {
        "inspected": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "required": [
        "lifecycle_lock",
        "listener_authenticated"
      ],
      "properties": {
        "lifecycle_lock": {
          "enum": [
            "not-inspected",
            "missing",
            "available",
            "held",
            "unknown"
          ]
        },
        "listener_authenticated": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "enum": [
          "config-missing",
          "config-unreadable",
          "config-invalid",
          "proxy-lock-unavailable"
        ]
      },
      "maxItems": 4
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phantom Secrets metadata status v1 (Phantom consumer boundary)"
}
