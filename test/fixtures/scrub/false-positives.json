    {"id": "fp-code-reference-014", "family": "code-reference", "text": "if (!process.env.STRIPE_SECRET_KEY) throw new Error('STRIPE_SECRET_KEY missing');"},
    {"id": "fp-code-reference-015", "family": "code-reference", "text": "          token: ${{ secrets.GITHUB_TOKEN }}"},
