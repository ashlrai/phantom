    {"id": "fp-code-reference-025", "family": "code-reference", "text": "self.client_secret = client_secret"},
    {"id": "fp-code-reference-026", "family": "code-reference", "text": "refresh_token: tokenResponse.refresh_token,"},
    {"id": "fp-code-reference-027", "family": "code-reference", "text": "Authorization: `Basic ${btoa(`${user}:${pass}`)}`,"},
    {"id": "fp-code-reference-028", "family": "code-reference", "text": "api_key: str = Field(..., alias=\"OPENAI_API_KEY\")"},
