{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "skip-github-release": true,
  "skip-changelog": false,
  "bump-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "@ashlr/phantom"
    }
  },
  "versioning": "always-bump-patch",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Fixes",
      "hidden": false
    },
    {
      "type": "bridge",
      "section": "Changes",
      "hidden": false
    },
    {
      "type": "perf",
      "section": "Performance",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "Maintenance",
      "hidden": false
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": false
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": false
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": false
    }
  ]
}
