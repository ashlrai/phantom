#!/usr/bin/env node
// Thin shim: delegate to the compiled CLI entrypoint, with fast paths for
// --version and status that skip the full dispatcher's module graph.
// Resolve relative to this file so the symlink in ~/.local/bin works.
import { fileURLToPath, pathToFileURL } from 'node:url';
import { dirname, resolve } from 'node:path';
import { readFileSync } from 'node:fs';
import { enableCompileCache } from 'node:module';

// Warm-start speedup: cache compiled bytecode for the dist/ module graph so
// V8 skips recompilation on the next run. enableCompileCache exists on every
// supported Node (>=22.15); the default dir honors NODE_COMPILE_CACHE and the
// cache is content-addressed, so a stale or unwritable cache can never break
// startup — it must never be allowed to, whatever the runtime returns.
try { enableCompileCache?.(); } catch { /* cache unavailable — run uncached */ }

const here = dirname(fileURLToPath(import.meta.url));
// Use a file:// URL, not a raw path: on Windows `import('C:\\...')` throws
// ERR_UNSUPPORTED_ESM_URL_SCHEME (the drive letter parses as a protocol).
const distUrl = (rel) => pathToFileURL(resolve(here, rel)).href;

const argv = process.argv.slice(2);
// Match the dispatcher's removal of one internal background-worker marker.
const workerFlagIdx = argv.indexOf('--_worker');
if (workerFlagIdx !== -1) argv.splice(workerFlagIdx, 1);
const command = argv[0];

if (command === '--version' || command === '-v' || command === 'version') {
  // Version must work without evaluating the CLI graph (even before a build).
  let version = process.env.ASHLR_VERSION;
  if (!version) {
    try {
      version = JSON.parse(readFileSync(new URL('../package.json', import.meta.url), 'utf8')).version;
    } catch {
      version = 'unknown';
    }
  }
  console.log(version);
} else if (command === 'status') {
  // The same handler as the full dispatcher, without its unrelated imports.
  const { runStatus } = await import(distUrl('../dist/cli/status.js'));
  await runStatus(argv.slice(1));
} else {
  await import(distUrl('../dist/cli/index.js'));
}
