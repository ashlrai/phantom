{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench.v1/audit-row.schema.json",
  "title": "workbench.audit-row.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ts", "actor", "verb", "args", "dry_run", "result", "refusal_reason", "command"],
  "properties": {
    "schema": {"type": "string", "enum": ["workbench.audit-row.v1"]},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:?[0-9]{2}|Z)$"},
    "actor": {"type": "string", "enum": ["ui", "cli"]},
    "verb": {"type": "string", "pattern": "^[a-z]+\\.?[a-z]*$", "maxLength": 40},
    "args": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lane": {"type": "string", "enum": ["codex-cmp", "codex-personal", "claude", "devin", "claude-api"]},
        "target": {"type": "integer", "minimum": 0, "maximum": 64},
        "rq_id": {"type": "string", "pattern": "^RQ-[A-Z0-9][A-Z0-9._-]{0,79}$"},
        "repo": {"type": "string", "pattern": "^ashlrai/[a-z0-9][a-z0-9-]{0,60}$"},
        "pr": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]}
      }
    },
    "dry_run": {"type": "boolean"},
    "result": {"type": "string", "enum": ["planned", "done", "refused", "error"]},
    "refusal_reason": {"type": ["string", "null"], "pattern": "^[a-z0-9_]{1,60}$"},
    "command": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 200}}
  }
}
