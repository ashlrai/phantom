{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench.v1/event.schema.json",
  "title": "workbench.event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "ts"],
  "properties": {
    "schema": {"type": "string", "enum": ["workbench.event.v1"]},
    "kind": {"type": "string", "enum": ["wb.snapshot", "wb.action", "wb.gh"]},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:?[0-9]{2}|Z)$"},
    "seq": {"type": "integer", "minimum": 1},
    "repo": {"type": "string", "pattern": "^ashlrai/[a-z0-9][a-z0-9-]{0,60}$"},
    "audit": {"$ref": "audit-row.schema.json"}
  }
}
