{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phm.dev/schemas/done-contract.v1.schema.json",
  "title": "done-contract.v1",
  "description": "Layered per-job done contract: framework floor checks, frozen acceptance criteria and verify commands. Structural subset — command-id uniqueness, evidence references and the at-least-one-layer rule are enforced by the validator (src/core/done-contract.ts).",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "done-contract.v1"
    },
    "job": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "frozenAt": {
      "type": "string"
    },
    "floor": {
      "type": "object",
      "properties": {
        "checks": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "typecheck",
              "unit",
              "lint",
              "secrets"
            ]
          }
        },
        "commands": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "cmd": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 3600000
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "cmd"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "type": "string",
            "pattern": "^(notes|manual|command:[a-z0-9][a-z0-9._-]{0,63}|file:.+)$"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "verify": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "cmd": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 3600000
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "cmd"
        ],
        "additionalProperties": false
      }
    },
    "notesFile": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema"
  ],
  "additionalProperties": false
}
