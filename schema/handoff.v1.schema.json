{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phm.dev/schema/handoff.v1.schema.json",
  "title": "ONE-TEAM handoff v1",
  "description": "Coordination claims only, not execution or lease authority. Payload references are opaque namespace:id locators, never inline content or credential-bearing URLs. Runtime validation also rejects recognized secret values through the shared secret scrubber.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "taskId", "fromProvider", "toProvider", "payloadRefs"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "enum": ["plan", "delegate", "ask", "review", "takeover", "result"] },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "not": { "pattern": "\\s" }
    },
    "fromProvider": { "$ref": "#/definitions/provider" },
    "toProvider": { "$ref": "#/definitions/provider" },
    "payloadRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256,
        "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9._/-]*$",
        "not": { "pattern": "\\s" }
      }
    }
  },
  "definitions": {
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$",
      "not": { "pattern": "\\s" }
    }
  }
}
