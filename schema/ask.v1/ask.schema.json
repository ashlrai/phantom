{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ask.v1/ask.schema.json",
  "title": "ask.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "text", "repo", "paths", "tier", "acceptance", "budget", "n", "pools_allowed", "state", "created_ts", "job_ids", "pr", "pr_url", "refusal_reason"],
  "properties": {
    "schema": {"type": "string", "enum": ["ask.v1"]},
    "id": {"$ref": "#/$defs/askId"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "repo": {"type": "string", "pattern": "^ashlrai/[a-z0-9][a-z0-9-]{0,60}$"},
    "paths": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 200, "pattern": "^(?!\\.github(/|$))(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._@+/-]+$"}},
    "tier": {"type": "string", "enum": ["work", "mid", "frontier"]},
    "acceptance": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["tokens_max", "usd_max", "wall_s_max"],
      "properties": {
        "tokens_max": {"type": "integer", "minimum": 1, "maximum": 50000000},
        "usd_max": {"type": "number", "minimum": 0, "maximum": 1000},
        "wall_s_max": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    },
    "n": {"type": "integer", "minimum": 1, "maximum": 3},
    "pools_allowed": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/pool"}},
    "state": {"$ref": "ask-status.schema.json#/$defs/state"},
    "created_ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:?[0-9]{2}|Z)$"},
    "job_ids": {"type": "array", "maxItems": 3, "items": {"type": "string", "pattern": "^RQ-[A-Z0-9][A-Z0-9._-]{0,79}$"}},
    "pr": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
    "pr_url": {"type": ["string", "null"], "pattern": "^https://github\\.com/ashlrai/[a-z0-9-]+/pull/[0-9]{1,7}$"},
    "refusal_reason": {"type": ["string", "null"], "enum": ["multi_repo", "github_path", "tier1_path", "hold_list", "bad_repo", "bad_path", "over_budget", "flag_off", "secret_shape", "no_pool", null]}
  },
  "$defs": {
    "askId": {"type": "string", "pattern": "^RQ-ASK-[0-9]{8}-[A-Z0-9]{4,12}$"},
    "pool": {"type": "string", "enum": ["codex-cmp", "codex-personal", "claude", "devin", "claude-api", "local", "cursor-cloud", "grok-build"]}
  }
}
